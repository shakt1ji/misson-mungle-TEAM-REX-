# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtual environments
.venv/
venv/
env/

# IDE and OS files
.vscode/
.idea/
.DS_Store
Thumbs.db

# Large datasets, GeoTIFF DEMs, and model weights (never commit to Git)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
*.tif
*.tiff
*.img
*.lbl
*.pt
*.pth
*.onnx
*.ckpt
*.h5
*.npy
*.npz

# Generated output plots and logs
outputs/
*.png
*.log
